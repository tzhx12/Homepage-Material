---
/**
 * 项目展示。featured 的项目会用强调色填充，适合放主力作品。
 *
 * 注意卡片容器始终是 <div>：<a> 里面不能再套 <a>，
 * 否则 HTML 解析器会强行断开外层标签，把 DOM 结构弄乱。
 * 这里用「拉伸链接」——标题上的 <a> 用伪元素铺满整张卡片，
 * 让整块可点，同时「源码」链接用 z-index 浮在它上面。
 */
import type { ProjectItem } from '../../config/modules.config';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  title?: string;
  icon?: string;
  hint?: string;
  items: ProjectItem[];
}

const { title = '项目', icon, hint, items } = Astro.props;

const isExternal = (href?: string) => Boolean(href?.startsWith('http'));
---

<section class="reveal">
  <SectionHeader title={title} icon={icon} hint={hint} />

  <div class="grid gap-3 sm:grid-cols-2">
    {
      items.map((project) => {
        const featured = Boolean(project.featured);
        const demoHref = project.href;
        const repoHref = project.repo;
        const hasRepoLink = Boolean(repoHref && repoHref !== demoHref);

        return (
          <div
            class:list={[
              'md-card relative flex flex-col gap-3 p-5',
              demoHref && 'md-card-interactive md-state-layer',
              featured &&
                '!bg-primary-container !border-transparent text-on-primary-container',
            ]}
            data-ripple={demoHref ? '' : undefined}
          >
            <div class="flex items-start gap-3">
              <span
                class:list={[
                  'flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-xl',
                  featured
                    ? 'bg-on-primary-container/10'
                    : 'bg-surface-container-high',
                ]}
                aria-hidden="true"
              >
                <Icon name={project.icon ?? 'folder'} size={20} />
              </span>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-bold">
                    {demoHref ? (
                      <a
                        href={demoHref}
                        target={isExternal(demoHref) ? '_blank' : undefined}
                        rel={isExternal(demoHref) ? 'noopener noreferrer' : undefined}
                        class="after:absolute after:inset-0 after:content-['']"
                      >
                        {project.name}
                      </a>
                    ) : (
                      project.name
                    )}
                  </h3>
                  {project.status && (
                    <span
                      class:list={[
                        'shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium',
                        featured
                          ? 'bg-on-primary-container/12 text-on-primary-container'
                          : 'bg-tertiary-container text-on-tertiary-container',
                      ]}
                    >
                      {project.status}
                    </span>
                  )}
                </div>
              </div>

              {demoHref && (
                <span
                  class:list={[
                    'shrink-0 opacity-45',
                    featured ? 'text-on-primary-container' : 'text-on-surface-variant',
                  ]}
                  aria-hidden="true"
                >
                  <Icon name="external" size={15} />
                </span>
              )}
            </div>

            <p
              class:list={[
                'flex-1 text-sm leading-relaxed',
                featured ? 'text-on-primary-container/85' : 'text-on-surface-variant',
              ]}
            >
              {project.description}
            </p>

            {project.tags && project.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-1 text-[11px] font-medium',
                      featured
                        ? 'bg-on-primary-container/12'
                        : 'bg-surface-container-high text-on-surface-variant',
                    ]}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            )}

            {hasRepoLink && (
              <a
                href={repoHref}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'md-state-layer relative z-10 -mb-1 inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold',
                  featured
                    ? 'bg-on-primary-container/12 text-on-primary-container'
                    : 'bg-secondary-container text-on-secondary-container',
                ]}
                data-ripple
              >
                <Icon name="github" size={14} />
                <span>源码</span>
              </a>
            )}
          </div>
        );
      })
    }
  </div>
</section>
