---
/**
 * 友链。头像支持图片和 emoji 两种写法，和 Icon 组件规则一致。
 */
import type { FriendItem } from '../../config/modules.config';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  title?: string;
  icon?: string;
  hint?: string;
  items: FriendItem[];
}

const { title = '友链', icon, hint, items } = Astro.props;

const isImage = (src: string) =>
  src.startsWith('/') ||
  src.startsWith('http://') ||
  src.startsWith('https://') ||
  src.startsWith('data:');
---

<section class="reveal">
  <SectionHeader title={title} icon={icon} hint={hint} />

  <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
    {
      items.map((friend) => (
        <a
          href={friend.href}
          target={friend.href.startsWith('http') ? '_blank' : undefined}
          rel={friend.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="md-card md-card-interactive md-state-layer flex items-center gap-3 !p-3.5"
          data-ripple
        >
          {isImage(friend.avatar) ? (
            <img
              src={friend.avatar}
              alt=""
              width="40"
              height="40"
              class="h-10 w-10 shrink-0 rounded-full object-cover"
              loading="lazy"
            />
          ) : (
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary-container text-lg"
              aria-hidden="true"
            >
              {friend.avatar}
            </span>
          )}

          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold text-on-surface">
              {friend.name}
            </span>
            {friend.description && (
              <span class="block truncate text-xs text-on-surface-variant">
                {friend.description}
              </span>
            )}
          </span>
        </a>
      ))
    }
  </div>
</section>
