---
/**
 * 常用链接。每个链接是一张可点击的小卡片。
 */
import type { LinkItem } from '../../config/modules.config';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { ACCENT_CONTAINER, resolveAccent } from '../../lib/accent';

interface Props {
  title?: string;
  icon?: string;
  hint?: string;
  items: LinkItem[];
}

const { title = '链接', icon, hint, items } = Astro.props;

const isExternal = (href: string) => href.startsWith('http');
---

<section class="reveal">
  <SectionHeader title={title} icon={icon} hint={hint} />

  <div class="flex flex-col gap-2.5">
    {
      items.map((item) => (
        <a
          href={item.href}
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          class="md-card md-card-interactive md-state-layer flex items-center gap-3 !p-3.5"
          data-ripple
        >
          <span
            class:list={[
              'flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl',
              // 统一用同一个颜色角色，单个条目可用 accent 字段覆盖
              ACCENT_CONTAINER[resolveAccent(item.accent)],
            ]}
          >
            <Icon name={item.icon} size={18} />
          </span>

          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold text-on-surface">
              {item.label}
            </span>
            {item.description && (
              <span class="block truncate text-xs text-on-surface-variant">
                {item.description}
              </span>
            )}
          </span>

          <span class="shrink-0 text-on-surface-variant opacity-50">
            <Icon name="external" size={16} />
          </span>
        </a>
      ))
    }
  </div>
</section>
