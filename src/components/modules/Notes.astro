---
/**
 * 便签。用强调色容器填充，适合放短句、公告、最近在想的事。
 */
import type { NoteItem } from '../../config/modules.config';
import SectionHeader from '../ui/SectionHeader.astro';
import { ACCENT_CONTAINER, resolveAccent } from '../../lib/accent';

interface Props {
  title?: string;
  icon?: string;
  hint?: string;
  items: NoteItem[];
}

const { title = '便签', icon, hint, items } = Astro.props;
---

<section class="reveal">
  <SectionHeader title={title} icon={icon} hint={hint} />

  <div class="flex flex-col gap-2.5">
    {
      items.map((note) => (
        <div
          class:list={[
            'relative overflow-hidden rounded-3xl px-5 py-4',
            // 统一用同一个颜色角色，单条可用 accent 字段覆盖
            ACCENT_CONTAINER[resolveAccent(note.accent)],
          ]}
        >
          <span
            class="pointer-events-none absolute -top-2 -right-1 text-5xl leading-none opacity-10 select-none"
            aria-hidden="true"
          >
            ”
          </span>

          <p class="relative text-sm leading-relaxed">{note.content}</p>

          {note.date && (
            <p class="relative mt-2 text-[11px] font-medium opacity-60">{note.date}</p>
          )}
        </div>
      ))
    }
  </div>
</section>
